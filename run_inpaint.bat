@echo offecho ==============================echo Выберите режим работы:echo 1 - Обработка видео с JSONecho 2 - Удаление объектов по JSONecho 3 - Inpaint (OpenCV / LAMA)echo ==============================set /p choice=Введите номер действия: if "%choice%"=="1" (    echo Запуск detect_to_json...    python detect_to_json.py    python process_video.py    pause    exit)if "%choice%"=="2" (    echo Запуск remove_from_json...    python remove_from_json.py    pause    exit)if "%choice%"=="3" (    echo Выбор модели для Inpaint:    echo 1 - OpenCV    echo 2 - LAMA/PyTorch    set /p model_choice=Введите номер модели:     if "%model_choice%"=="1" (        echo Запуск OpenCV Inpaint...        python inpaint_choice.py --model opencv    )    if "%model_choice%"=="2" (        echo Запуск LAMA Inpaint...        python inpaint_choice.py --model lama    )    pause    exit)echo Неверный выбор!pause